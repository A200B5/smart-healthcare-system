# ============================================================
#   DEPI Smart Healthcare  |  Backend Environment Config
# ============================================================

# Server
PORT=5000

# ── SQL Server Connection ─────────────────────────────────────
# Change these values to match your SSMS setup
DB_SERVER=localhost\SQLEXPRESS          # your SQL Server hostname or IP
DB_PORT=1433
DB_NAME=depi                 # the database name created by depi_database.sql
DB_USER=sa                   # your SQL Server login
DB_PASSWORD=123456  # your SQL Server password
DB_ENCRYPT=false             # set to true if using Azure SQL
DB_TRUST_CERT=true           # keep true for local development

# ── JWT Auth ──────────────────────────────────────────────────
JWT_SECRET=depi_smart_healthcare_jwt_secret_2026
JWT_EXPIRES_IN=1h

# ── CORS ──────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173
